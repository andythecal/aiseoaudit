Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(?:src|vendor|config|storage|database|bin|tests|docs|\.git|\.agents|\.codex)(?:/|$) - [F,L,NC]
RewriteRule ^(?:deploy\.php|bootstrap\.php|auditor\.md|README\.md|.*\.(?:sql|log|ini|bak|env))$ - [F,L,NC]
</IfModule>
<FilesMatch "^\.">
Require all denied
</FilesMatch>
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "DENY"
</IfModule>
